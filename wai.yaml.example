# WAI Configuration — copy to wai.yaml and set secrets in .env.local

server:
  proxy:
    port: 8090
  admin:
    port: 0

database:
  driver: postgres
  # Local Windows Postgres — sslmode=disable is expected on loopback only.
  dsn: postgres://postgres:${POSTGRES_PASSWORD}@localhost:5432/wai?sslmode=disable
  # Tune for concurrent users behind a load balancer (default: 25 open, 5 idle)
  max_open_conns: 25
  max_idle_conns: 5
  conn_max_lifetime: 5m

models:
  - name: gpt-4o-azure
    provider: azure
    type: chat
    base_url: ${AZURE_OPENAI_ENDPOINT}
    api_key: ${AZURE_OPENAI_KEY}
    azure_deployment: gpt-4o
    azure_api_version: "2024-02-01"
    aliases:
      - default
      - azure

  - name: llama-local
    provider: ollama
    type: chat
    base_url: http://127.0.0.1:11434/v1
    aliases:
      - local

settings:
  admin_key: ${WAI_ADMIN_KEY}
  encryption_key: ${WAI_ENCRYPTION_KEY}
  fallback_max_depth: 5
  health_check_interval_seconds: 60
  # Hybrid auto router: model "auto" picks from accessible models
  auto_router:
    enabled: true
    default_model: qwen3-coder:30b-gpu
    classifier_model: qwen3-coder:30b-gpu
    classifier_timeout_seconds: 8
    # complex_mode: random | fixed
    complex_mode: random
    complex_model: ""
  rate_limit:
    login_max_attempts: 10
    login_window_minutes: 15
    invite_max_attempts: 5
    invite_window_minutes: 15

# Model catalog pricing sync (Models > Sync pricing). Prices come from LiteLLM's community
# price list. The admin UI previews changes; nothing is written until an admin applies them.
pricing:
  # Outbound HTTPS to GitHub raw is needed unless local_path is set.
  source_url: https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
  # Air-gapped installs: download the JSON elsewhere and point at the file (overrides source_url).
  local_path: ""
  # Daily background sync; only updates models whose pricing source is "synced".
  auto_sync: false
  auto_sync_interval_hours: 24

# Proxy reliability: per-deployment circuit breakers and retry backoff (all optional;
# these are the defaults). A circuit opens after consecutive upstream failures
# (network errors, timeouts, 5xx, 429); other 4xx never count. While open, the
# deployment is skipped; if every deployment is open the least recently failed one is
# still tried, so traffic is never blackholed.
reliability:
  circuit_enabled: true
  circuit_failure_threshold: 5
  # Also open when this fraction of requests in the window failed (0 = off).
  circuit_failure_rate_threshold: 0
  circuit_window_seconds: 60
  circuit_min_requests: 20
  # First cooldown; doubles on each re-trip, capped at the max.
  circuit_cooldown_seconds: 30
  circuit_max_cooldown_seconds: 300
  # A 429 with Retry-After opens the circuit for that long.
  circuit_open_on_retry_after: true
  circuit_max_entries: 2048
  # Backoff between retries (model max_retries > 0): exponential with jitter.
  retry_backoff_base_ms: 100
  retry_backoff_max_ms: 2000
  # Wait out an upstream Retry-After up to this long, else move to the next model.
  retry_after_max_seconds: 10
  # Total retry time when the model has no timeout (else the model timeout applies).
  retry_budget_seconds: 60

# Optional: Microsoft Entra ID (or any OIDC) single sign-on.
# Put AZURE_AD_TENANT_ID / AZURE_AD_CLIENT_ID / AZURE_AD_CLIENT_SECRET in .env.local and
# register redirect_url as a "Web" redirect URI on the app registration.
# sso:
#   enabled: true
#   issuer: https://login.microsoftonline.com/${AZURE_AD_TENANT_ID}/v2.0
#   client_id: ${AZURE_AD_CLIENT_ID}
#   client_secret: ${AZURE_AD_CLIENT_SECRET}
#   redirect_url: https://your-host/api/v1/auth/oidc/callback
#   scopes: [openid, profile, email]
#   allowed_domains: [example.com]   # also enables linking SSO to existing accounts with the same email
#   auto_provision: true
#   default_role: member
#   default_org_name: "Example Org"  # created at startup if missing; new SSO users join it
#   default_org_slug: example-org
#   migrate_from_org_slug: default   # existing users in this org move to default_org_slug on SSO login
